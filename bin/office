#!/bin/sh
# herdr can start panes and actions with a minimal PATH, where python3 may be an old system one.
root=$(cd "$(dirname "$0")/.." && pwd -P)
for py in python3 python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m office "$@"
  fi
done
echo "herdr-office needs Python 3.11 or newer" >&2
exit 1
